# LLM API 密钥（必填）。DeepSeek 官方 / 中转平台 / 千问AI平台 key 均可
DEEPSEEK_API_KEY=your-key-here

# OpenAI 兼容接口地址（可选，默认 DeepSeek 官方 https://api.deepseek.com）
# CloseAI 中转示例：https://api.openai-proxy.org/v1
# 千问AI平台示例：https://maas.qianwenaiapi.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名（可选，默认 deepseek-chat；各平台请以自己的模型列表为准）
DEEPSEEK_MODEL=deepseek-chat

# HuggingFace 国内镜像（首次下载 embedding 模型用）
HF_ENDPOINT=https://hf-mirror.com

# LangSmith 追踪（可选，https://smith.langchain.com 创建 key 后填入）
# 填好后无需改代码，LangChain 自动上报每次调用的完整 trace
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxx
# LANGSMITH_PROJECT=rag-doc-assistant
